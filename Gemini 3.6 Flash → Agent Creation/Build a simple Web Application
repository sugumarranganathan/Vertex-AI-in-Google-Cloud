                    })

            });


        const data =
            await response.json();


        // Remove thinking message
        thinkingDiv.remove();


        if (!response.ok) {

            addMessage(
                "⚠️ Sorry, something went wrong. Please try again.",
                "bot"
            );

            console.error(data);

            return;

        }


        if (data.response) {

            addMessage(
                data.response,
                "bot"
            );

        } else {

            addMessage(
                "⚠️ Sorry, I could not generate a response.",
                "bot"
            );

