        print("========================================")

        print("\nAgent URL:")
        print(AGENT_URL)

        print("\nUser Message:")
        print(message)

        print("\nPayload:")
        print(json.dumps(payload, indent=2))


        # =================================================
        # CALL VERTEX AI AGENT ENGINE
        # =================================================

        response = requests.post(
            AGENT_URL,
            headers=headers,
            json=payload,
            timeout=120
        )


        print("\n========================================")
        print("AGENT RESPONSE")
        print("========================================")

        print("\nStatus Code:")
        print(response.status_code)

        print("\nRaw Response:")
        print(response.text)


        # =================================================
        # HANDLE API ERROR
        # =================================================

        if response.status_code != 200:

            return jsonify({
                "error": "AI Agent returned an error",
                "details": response.text
            }), response.status_code


        # =================================================
        # PARSE RESPONSE
        # =================================================

        result = response.json()


        print("\nParsed Response:")
        print(result)


        ai_response = ""


        # =================================================
        # HANDLE LIST RESPONSE
        # =================================================

        if isinstance(result, list):

            for item in result:

                if not isinstance(item, dict):
                    continue


                content = item.get(
                    "content",
                    {}
                )


                if not isinstance(content, dict):
                    continue


                parts = content.get(
                    "parts",
                    []
                )


                for part in parts:

                    if not isinstance(
                        part,
                        dict
                    ):
                        continue


                    text = part.get("text")


                    if text:
                        ai_response += text


        # =================================================
        # HANDLE DICTIONARY RESPONSE
        # =================================================

        elif isinstance(result, dict):

            content = result.get(
