def chat():

    data = request.get_json()

    if not data:
        return jsonify({
            "error": "Invalid request"
        }), 400


    message = data.get("message", "").strip()


    if not message:
        return jsonify({
            "error": "Please enter a message"
        }), 400


    try:

        # =================================================
        # GET ACCESS TOKEN
        # =================================================

        token = get_access_token()


        headers = {
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json"
        }


